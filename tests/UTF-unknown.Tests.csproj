<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Full matrix in CI; locally only net481 and net10.0 to keep the inner loop fast -->
    <TargetFrameworks Condition=" '$(GITHUB_ACTIONS)' == 'true' ">net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(GITHUB_ACTIONS)' != 'true' ">net481;net10.0</TargetFrameworks>
    <RootNamespace>UtfUnknown.Tests</RootNamespace>
    <AssemblyName>UtfUnknown.Tests</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\src\UtfUnknown.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\UTF-unknown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\ibm850\" />
  </ItemGroup>

</Project>
